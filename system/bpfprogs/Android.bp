// SEC_PRODUCT_FEATURE_RIL_SUPPORT_CROSS_LAYER_OPTIMIZER {
soong_config_module_type {
    name: "clo_bpf",
    module_type: "libbpf_prog",
    config_namespace: "SEC_CLO",
    bool_variables: ["SEC_PRODUCT_FEATURE_RIL_SUPPORT_CROSS_LAYER_OPTIMIZER"],
    properties: ["cflags", "enabled"],
}
// SEC_PRODUCT_FEATURE_RIL_SUPPORT_CROSS_LAYER_OPTIMIZER }

// SEC_PRODUCT_FEATURE_RIL_SUPPORT_MOBILE_NETWORK_EXPERIENCE_BOOSTER {
soong_config_module_type {
    name: "mnxb_bpf",
    module_type: "libbpf_prog",
    config_namespace: "SEC_MNXB",
    bool_variables: ["SEC_PRODUCT_FEATURE_RIL_SUPPORT_MOBILE_NETWORK_EXPERIENCE_BOOSTER"],
    properties: ["cflags", "enabled"],
}
// SEC_PRODUCT_FEATURE_RIL_SUPPORT_MOBILE_NETWORK_EXPERIENCE_BOOSTER }

package {
    default_team: "trendy_team_fwk_core_networking",
    default_applicable_licenses: ["system_bpfprogs_license"],
}

license {
    name: "system_bpfprogs_license",
    license_kinds: [
        "SPDX-license-identifier-GPL-2.0",
    ],
    license_text: ["LICENSE"],
}

libbpf_prog {
    name: "timeInState.bpf",
    srcs: ["timeInState.c"],
    header_libs: [
        "bpf_prog_headers",
        "libcutils_headers",
        "android_bpf_defs",
    ],
    relative_install_path: "cputimeinstate",
}

libbpf_prog {
    name: "fuseMedia.bpf",
    srcs: ["fuseMedia.c"],
    header_libs: [
        "android_bpf_defs",
        "libfuse_headers",
    ],
}

aconfig_declarations {
    name: "android_bpfprogs_flags",
    package: "android.bpfprogs.flags",
    container: "system",
    srcs: [
        "progs.aconfig",
    ],
}

rust_aconfig_library {
    name: "libandroid_bpfprogs_flags",
    crate_name: "android_bpfprogs_flags",
    aconfig_declarations: "android_bpfprogs_flags",
}

java_aconfig_library {
    name: "android.bpfprogs.flags-aconfig-java",
    aconfig_declarations: "android_bpfprogs_flags",
}

cc_aconfig_library {
    name: "android.bpfprogs.flags-aconfig-cpp",
    aconfig_declarations: "android_bpfprogs_flags",
}

libbpf_prog {
    name: "dmabufIter.bpf",
    srcs: ["dmabufIter.c"],
    header_libs: [
        "android_bpf_defs",
        "vmlinux_h_5_10",
    ],
    cflags: [
        "-DUSE_VMLINUX",
    ],
    relative_install_path: "dmabuf",
    arch: {
        // RISC-V is not a supported architecture, so we don't have a vmlinux.
        riscv64: {
            enabled: false,
        },
    },
}

libbpf_prog {
    name: "cyclePerUid.bpf",
    srcs: ["cyclePerUid.c"],
    header_libs: [
        "android_bpf_defs",
        "bpf_prog_headers",
        "libcutils_headers",
        "vmlinux_h_5_10",
    ],
    cflags: [
        "-DUSE_VMLINUX",
    ],
    relative_install_path: "cpucycleperuid",
    enabled: false,
    arch: {
        x86_64: {
            enabled: true,
        },
    },
}

libbpf_prog {
    name: "semSmartHS.bpf",
    srcs: ["semSmartHS.c"],
    header_libs: [
        "bpf_prog_headers",
        "android_bpf_defs",
        "libcutils_headers",
    ],
}

libbpf_prog {
    name: "semUidBPF.bpf",
    srcs: ["semUidBPF.c"],
    header_libs: [
        "bpf_prog_headers",
        "android_bpf_defs",
        "libcutils_headers",
    ],
}

libbpf_prog {
    name: "tcpAccECN.bpf",
    srcs: ["tcpAccECN.c"],
    header_libs: [
        "bpf_prog_headers",
        "android_bpf_defs",
        "libcutils_headers",
    ],
}

mnxb_bpf {
    name: "mnxbNetd.bpf",
    srcs: ["mnxbNetd.c"],
    header_libs: [
        "bpf_prog_headers",
        "android_bpf_defs",
        "libcutils_headers",
    ],
    enabled: false,
    soong_config_variables: {
        SEC_PRODUCT_FEATURE_RIL_SUPPORT_MOBILE_NETWORK_EXPERIENCE_BOOSTER: {
            enabled: true,
            cflags: ["-DSEC_PRODUCT_FEATURE_RIL_SUPPORT_MOBILE_NETWORK_EXPERIENCE_BOOSTER"],
        },
    },
}

libbpf_prog {
    name: "tosMarker.bpf",
    srcs: ["tosMarker.c"],
    header_libs: [
        "bpf_prog_headers",
        "android_bpf_defs",
        "libcutils_headers",
    ],
}

// SEC_PRODUCT_FEATURE_RIL_SUPPORT_CROSS_LAYER_OPTIMIZER {
clo_bpf {
    name: "cloBpf.bpf",
    srcs: ["cloBpf.c"],
    header_libs: [
        "bpf_prog_headers",
        "android_bpf_defs",
        "libcutils_headers",
    ],
    enabled: false,
    soong_config_variables: {
        SEC_PRODUCT_FEATURE_RIL_SUPPORT_CROSS_LAYER_OPTIMIZER: {
            enabled: true,
            cflags: ["-DSEC_PRODUCT_FEATURE_RIL_SUPPORT_CROSS_LAYER_OPTIMIZER"],
        },
    },
}
// SEC_PRODUCT_FEATURE_RIL_SUPPORT_CROSS_LAYER_OPTIMIZER }

libbpf_prog {
    name: "semPacketMonitor.bpf",
    srcs: ["semPacketMonitor.c"],
    header_libs: [
        "bpf_prog_headers",
        "android_bpf_defs",
        "libcutils_headers",
    ],
}