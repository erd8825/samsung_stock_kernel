cc_library_shared {
    name: "libsensorList.erd8825",
    // tags: ["optional"],
    proprietary: true,
    srcs: ["*.cpp"],
    cflags: [
        "-Wall", "-Werror", "-Wextra",
        "-DLOG_TAG=\"ExynosSensorHal\"",
        "-DEXYNOS_CONTEXTHUB",
    ],
    ldflags: [
        "-coverage"
        ],
    header_libs: [
        "libSensorList_headers",
        "libHubConnection2_headers"
    ],
    native_coverage: true,
}

