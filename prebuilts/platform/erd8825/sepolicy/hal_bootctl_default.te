#============= hal_bootctl_default ==============
allow hal_bootctl_default block_device:dir search;
allow hal_bootctl_default proc_cmdline:file { read open getattr };
allow hal_bootctl_default sysfs_dt_firmware_android:dir { search read open };
allow hal_bootctl_default sysfs_dt_firmware_android:file { read open getattr };
allow hal_bootctl_default misc_block_device:blk_file { read open };
