# Applies before LSI device.mk files

PRODUCT_BUILD_ODM_IMAGE := true

FSTAB_FILE := fstab.$(TARGET_SOC)
COMMON_PATH_BASE := device/samsung/common
PRODUCT_COPY_FILES += \
	$(COMMON_PATH_BASE)/$(FSTAB_FILE):$(TARGET_COPY_OUT_VENDOR)/etc/fstab.$(TARGET_SOC) \
	$(COMMON_PATH_BASE)/$(FSTAB_FILE):$(TARGET_COPY_OUT_VENDOR_RAMDISK)/fstab.$(TARGET_SOC) \
	$(COMMON_PATH_BASE)/$(FSTAB_FILE):$(TARGET_COPY_OUT_VENDOR_RAMDISK)/first_stage_ramdisk/fstab.$(TARGET_SOC)
