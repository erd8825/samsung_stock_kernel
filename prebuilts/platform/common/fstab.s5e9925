# Android fstab file.
#<src>                  <mnt_point>         <type>    <mnt_flags and options>                               <fs_mgr_flags>
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK
system                                             /system             erofs      ro                                                   wait,logical,first_stage_mount,avb=vbmeta_system,avb_keys=/avb
# During compliance testing, the previous line would fail (because ESSI is ext4), and the next line would be used to mount ESSI.
system                                             /system             ext4       ro,barrier=1                                         wait,logical,first_stage_mount,avb=vbmeta_system,avb_keys=/avb
system_ext                                         /system_ext         erofs      ro                                                   wait,logical,first_stage_mount,avb
vendor                                             /vendor             erofs      ro                                                   wait,logical,first_stage_mount,avb
system_dlkm                                        /system_dlkm        erofs      ro                                                   wait,logical,first_stage_mount,avb
vendor_dlkm                                        /vendor_dlkm        erofs      ro                                                   wait,logical,first_stage_mount,avb
product                                            /product            erofs      ro                                                   wait,logical,first_stage_mount,avb
odm                                                /odm                erofs      ro                                                   wait,logical,first_stage_mount,avb

/dev/block/by-name/boot      /boot               emmc      defaults                                              first_stage_mount,formattable,avb=boot
/dev/block/by-name/vendor_boot /vendor_boot      emmc      defaults                                              first_stage_mount,formattable,avb=vendor_boot
/dev/block/by-name/dtbo      /dtbo               emmc      defaults                                              first_stage_mount,formattable,avb=dtbo
/dev/block/by-name/vbmeta      /vbmeta           emmc      defaults					       						 first_stage_mount,formattable,avb=vbmeta
/dev/block/by-name/vbmeta_system      /vbmeta_system      emmc      defaults                                     first_stage_mount,formattable,avb=vbmeta_system
/dev/block/by-name/metadata  /metadata           ext4      noatime,nosuid,nodev,sync                            wait,formattable,first_stage_mount
/dev/block/by-name/userdata   /data              f2fs      rw,noatime,nosuid,nodev,discard,fsync_mode=nobarrier  latemount,wait,check,quota,reservedsize=128M
/dev/block/by-name/efs    /mnt/vendor/efs                ext4      defaults,rw                                           wait
/dev/block/by-name/cpefs        /mnt/vendor/cpefs   ext4      noatime,nosuid,nodev,noauto_da_alloc,discard,journal_checksum,data=ordered,errors=panic         wait,check,nofail
#/dev/block/by-name/persist   /mnt/vendor/persist ext4      noatime,nosuid,nodev,barrier=1,data=ordered,nodelalloc,nomblk_io_submit,errors=panic wait,notrim
/dev/block/by-name/misc      /misc               emmc      defaults                                              defaults,first_stage_mount
/dev/block/by-name/recovery  /recovery           emmc      defaults                                              first_stage_mount
/dev/block/by-name/cache    /cache              ext4      noatime,nosuid,nodev,nomblk_io_submit,errors=panic    wait
/dev/block/by-name/keystorage  /keystorage       emmc      defaults                                             first_stage_mount
/dev/block/by-name/harx        /harx             emmc      defaults                                             first_stage_mount

/dev/block/by-name/prism        /prism                  ext4    ro,barrier=1    nofail,first_stage_mount,avb
/dev/block/by-name/optics       /optics                 ext4    ro,barrier=1    nofail,first_stage_mount,avb
/dev/block/by-name/sec_efs      /efs                    ext4    nosuid,nodev,noatime,noauto_da_alloc,discard,journal_checksum,data=ordered,errors=panic wait

# VOLD:fstab.s5e9925
/devices/platform/10b00000.usb*                    auto                vfat      default                                               voldmanaged=usb:auto

# Samsung ODE
/dev/block/by-name/keyrefuge    /keyrefuge          f2fs      rw,noatime,nosuid,nodev,discard,fsync_mode=strict         wait,check,nofail
