CONFIG_IF_CB_MANAGER=y
CONFIG_IF_CB_MANAGER_MODULE=m
CONFIG_CCIC_NOTIFIER=y
CONFIG_CCIC_NOTIFIER_MODULE=m
CONFIG_CCIC_MAX77705=y
CONFIG_CCIC_MAX77705_MODULE=m
CONFIG_SWITCH=m
CONFIG_MFD_MAX77705=m
CONFIG_VBUS_NOTIFIER=y
CONFIG_VBUS_NOTIFIER_MODULE=m
CONFIG_USE_MUIC=y
CONFIG_USE_SAFEOUT=y
CONFIG_MUIC_NOTIFIER=y
CONFIG_MUIC_NOTIFIER_MODULE=m
CONFIG_MUIC_SUPPORT_CCIC=y
CONFIG_MUIC_MAX77705=y
CONFIG_HV_MUIC_MAX77705_AFC=y
