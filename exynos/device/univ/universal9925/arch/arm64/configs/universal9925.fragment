# CONFIG_REINIT_VSS is not set
CONFIG_VERIFY_VSS=m
CONFIG_CPIF_DIRECT_DM=m
CONFIG_CPIF_VENDOR_HOOK=m
CONFIG_CP_UART_NOTI=m

# GNSS
CONFIG_GNSS_PMUCAL=m
CONFIG_EXYNOS_GNSS_IF=m

# SEC CONFIGS
