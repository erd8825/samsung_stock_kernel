load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@bazel_skylib//lib:selects.bzl", "selects")
load("//common:modules.bzl", "get_gki_modules_list")
load("//build/bazel_common_rules/dist:dist.bzl", "copy_to_dist_dir")
load(
    "//build/kernel/kleaf:kernel.bzl",
    "kernel_abi",
    "kernel_build",
    "kernel_module",
    "kernel_module_group",
    "kernel_modules_install",
    "kernel_images",
    "kernel_unstripped_modules_archive",
    "merged_kernel_uapi_headers",
)
load("//build/kernel/kleaf:hermetic_tools.bzl", "hermetic_genrule")
load("//exynos/soc-series/common/impl:vendor_ramdisk.bzl", "create_vendor_ramdisk")
load("//exynos/soc-series/common/impl:dtbo_cfg.bzl", "dtbo_cfg")
load("//exynos/soc-series/common/impl:check_module_list.bzl", "check_module_list")
load(":modules.bzl",
    "get_common_kernel_modules_list",
    "get_all_vendor_boot_modules_list",
    "get_all_system_dlkm_blocklist",
    "get_all_vendor_dlkm_blocklist",
    "register_univ9925_module",
    "get_all_vendor_dlkm_modules_list",
    "get_all_kunit_test_list",
)
load("//exynos/soc-series/common/impl:create_blocklist.bzl", "create_blocklist")

package(
    default_visibility = [
        "//exynos/soc-series:__subpackages__",
    ],
)

__soc_dtbs = [
    "//exynos/device/univ/universal9925:universal9925/s5e9925-universal9925_rev00.dtbo",
    "//exynos/device/univ/universal9925:universal9925/s5e9925-universal9925_rev17.dtbo",
    "//exynos/device/univ/universal9925:universal9925/s5e9925-universal9925_rev1b.dtbo",
    "//exynos/device/univ/universal9925:universal9925/exynos-base-dts/s5e9925.dtb",
]

__make_goals = [
    "modules",
    "dtbs",
]

write_file(
    name = "vendor_kunit_modules_list",
    out = "vendor_kunit_modules.universal9925",
    content = select({
        "//exynos/soc-series/common:eng_build": get_all_kunit_test_list("eng"),
        "//exynos/soc-series/common:userdebug_build": get_all_kunit_test_list("userdebug"),
        "//exynos/soc-series/common:user_build": get_all_kunit_test_list("user"),
    })
)

write_file(
    name = "vendor_dlkm_modules_list",
    out = "vendor_dlkm_modules.universal9925",
    content = select({
        "//exynos/soc-series/common:eng_build": get_all_vendor_dlkm_modules_list("eng"),
        "//exynos/soc-series/common:userdebug_build": get_all_vendor_dlkm_modules_list("userdebug"),
        "//exynos/soc-series/common:user_build": get_all_vendor_dlkm_modules_list("user"),
    })
)

write_file(
    name = "universal9925_vendor_dlkm_blocklist",
    out = "vendor_dlkm.modules.blocklist.universal9925",
    content = get_all_vendor_dlkm_blocklist()
)

write_file(
    name = "universal9925_system_dlkm_blocklist",
    out = "system_dlkm.modules.blocklist.universal9925",
    content = get_all_system_dlkm_blocklist()
)

create_blocklist(
    name = "universal9925_vendor_dlkm_modules_blocklist",
    modules_blocklist = ":universal9925_vendor_dlkm_blocklist"
)

create_blocklist(
    name = "universal9925_system_dlkm_modules_blocklist",
    modules_blocklist = ":universal9925_system_dlkm_blocklist"
)

kernel_build(
    name = "universal9925",
    base_kernel = "//common:kernel_aarch64",
    srcs = glob([
            "build.config.*",
            "arch/arm64/boot/dts/**",
            "arch/arm64/configs/**",
            "Kconfig.ext",
            "Kconfig.ext_modules",
        ],
        exclude =[
            ".*",
            ".*/**",
            "BUILD.bazel",
            "**/*.bzl",
            "build.config.*",
        ],
    ) + [
        # keep sorted
        "//common:common_kernel_sources",
        "//exynos/soc-series/pamir-android15:exynos.soc_kconfig",
        "//exynos/soc-series/pamir-android15:exynos.soc_fragment",
        "//exynos/soc-series/pamir-android15:build.config.s5e9925_v",
        "//exynos/soc-series/pamir-android15:exynos.dt-bindings",
        "//exynos/device/univ/universal9925:exynos.universal9925_kconfig",
        "//exynos/external-modules/sgpu:sgpu.kconfig",
    ],
    kmi_symbol_list = select({
        "//exynos/soc-series/common:abi_update": "//common:android/abi_gki_aarch64_exynos",
        "//conditions:default": None,
    }),
    trim_nonlisted_kmi = False,
    kmi_symbol_list_strict_mode = False,
    outs = [
        ".config",
        "vmlinux",
        "Module.symvers",
        "modules.order",
        "exynos-base-dts/s5e9925.dtb",
        "s5e9925-universal9925_rev00.dtbo",
        "s5e9925-universal9925_rev17.dtbo",
        "s5e9925-universal9925_rev1b.dtbo",
    ],
    kconfig_ext = ":Kconfig.ext",
    build_config = ":build.config.universal9925_v",
    dtstree = "//exynos/device/univ/universal9925/arch/arm64/boot/dts:universal9925_dt",
    # in-tree kernel modules
    module_outs = get_common_kernel_modules_list(),
    collect_unstripped_modules = True,
    strip_modules = True,
    make_goals = __make_goals,
    defconfig_fragments = select({
        "//exynos/soc-series/common:eng_build": [ ":arch/arm64/configs/eng.fragment"],
        "//exynos/soc-series/common:userdebug_build": [ ":arch/arm64/configs/userdebug.fragment"],
        "//exynos/soc-series/common:user_build": [ ":arch/arm64/configs/user.fragment"],
    }),
)

kernel_abi(
    name = "universal9925_abi",
    kernel_build = ":universal9925",
    kernel_modules = [
        ":universal9925_ext_modules",
    ],
    kmi_enforced = True,
    kmi_symbol_list_add_only = True,
    module_grouping = True,
)

filegroup(
    name = "exynos.universal9925_sources",
    srcs = glob(
        ["**"],
        exclude = [
            ".*",
            ".*/**",
            "BUILD.bazel",
            "**/*.bzl",
            "build.config.*",
        ],
    ),
    visibility = [
        "//exynos/device:__subpackages__",
    ],
)

filegroup(
    name = "exynos.universal9925_kconfig",
    srcs = glob([
        "**/Kconfig",
    ]) + [
        "Kconfig.ext",
        "Kconfig.ext_modules",
    ],
    visibility = [
        "//exynos/device:__subpackages__",
    ],
)

alias(
    name = "universal9925_module",
    actual = select({
        "//exynos/soc-series/common:eng_build": ":universal9925_module.eng",
        "//exynos/soc-series/common:userdebug_build": ":universal9925_module.userdebug",
        "//exynos/soc-series/common:user_build": ":universal9925_module.user",
    }),
)

alias(
	name = "sgpu_modules",
	actual = select({
		"//conditions:default": "//exynos/external-modules/sgpu:sgpu",
	}),
)

kernel_module_group(
    name = "universal9925_ext_modules",
    srcs = [
        "//exynos/soc-series/common:exynos_soc_module",
        ":sgpu_modules",
        ":universal9925_module",
    ],
)

kernel_modules_install(
    name = "universal9925_modules_install",
    kernel_build = "//exynos/soc-series/common:exynos_kernel_build",
    kernel_modules = [":universal9925_ext_modules"],
    outs = ["modules.dep", "modules.alias"],
)


check_module_list(
    name = "universal9925_check_module_list",
    kernel_modules_install = ":universal9925_modules_install",
    vendor_boot_kernel_modules = ":vendor_boot_modules_list",
    system_dlkm_kernel_modules = ":system_dlkm_modules_list",
    vendor_dlkm_kernel_modules = ":vendor_dlkm_modules_list",
)

merged_kernel_uapi_headers(
    name = "universal9925_merged_uapi_headers",
    kernel_build = "//exynos/soc-series/common:exynos_kernel_build",
    kernel_modules = [":universal9925_ext_modules"],
)

kernel_unstripped_modules_archive(
    name = "universal9925_module_symbols",
    kernel_build = "//exynos/soc-series/common:exynos_kernel_build",
    kernel_modules = [":universal9925_ext_modules"],
)

write_file(
    name = "vendor_boot_modules_list",
    out = "vendor_boot.modules.universal9925",
    content = select({
        "//exynos/soc-series/common:eng_build": get_all_vendor_boot_modules_list("eng"),
        "//exynos/soc-series/common:userdebug_build": get_all_vendor_boot_modules_list("userdebug"),
        "//exynos/soc-series/common:user_build": get_all_vendor_boot_modules_list("user"),
    })
)

write_file(
    name = "system_dlkm_modules_list",
    out = "system_dlkm_modules_list.universal9925",
    content = get_gki_modules_list("arm64"),
)

create_vendor_ramdisk(
    name = "universal9925_custom_vendor_ramdisk",
    vendor_files = [
        "//prebuilts/platform/universal9925:conf/fstab.s5e9925.ufs",
        "//prebuilts/platform/universal9925:conf/init.recovery.s5e9925.rc",
        "//prebuilts/platform/universal9925:conf/init.s5e9925.usb.rc",
        "//prebuilts/platform/universal9925:firmware/sgpu/vangogh_lite_unified.bin",
    ],
    vendor_ramdisk_list = [":vendor_ramdisk.cfg",],
)

kernel_images(
    name = "universal9925_images",
    build_initramfs = True,
    build_boot = True,
    build_vendor_boot = True,
    kernel_build = "//exynos/soc-series/common:exynos_kernel_build",
    kernel_modules_install = "universal9925_modules_install",
    base_kernel_images = "//common:kernel_aarch64_images",
    vendor_ramdisk_binaries = [
        ":universal9925_custom_vendor_ramdisk",
    ],
    modules_list = ":vendor_boot_modules_list",
    modules_options = ":vendor_boot.modules.options",
    build_system_dlkm = True,
    system_dlkm_modules_list = ":system_dlkm_modules_list",
    system_dlkm_fs_type = "erofs",
    system_dlkm_modules_blocklist = ":universal9925_system_dlkm_modules_blocklist",
    dedup_dlkm_modules = True,
    build_vendor_dlkm = True,
    vendor_dlkm_archive = True,
    vendor_dlkm_fs_type = "erofs",
    vendor_dlkm_modules_list = ":vendor_dlkm_modules_list",
    vendor_dlkm_modules_blocklist = ":universal9925_vendor_dlkm_modules_blocklist",
    vendor_dlkm_props = ":vendor_dlkm_props",
    deps = [
        "//exynos/soc-series/common/impl:file_contexts",
    ],
)

dtbo_cfg(
    name = "universal9925_dtbo_cfg",
    srcs = __soc_dtbs,
    config_file = ":dtboimg.cfg",
)

copy_to_dist_dir(
    name = "universal9925_dist",
    data = [
        ":universal9925",
        ":universal9925_dtbo_cfg",
        ":universal9925_images",
        ":universal9925_modules_install",
        ":universal9925_module_symbols",
        ":universal9925_merged_uapi_headers",
        ":universal9925_check_module_list",
        ":vendor_kunit_modules_list",
        ":vendor_boot.modules.options",
    ],
    dist_dir = "out/universal9925/dist",
    flat = True,
    log = "info",
)

register_univ9925_module()
