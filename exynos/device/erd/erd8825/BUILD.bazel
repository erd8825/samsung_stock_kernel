load(":mx_kernel.bzl", "mx_kernel_rules")
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@bazel_skylib//lib:selects.bzl", "selects")
load("//common:modules.bzl", "get_gki_modules_list")
load("//build/bazel_common_rules/dist:dist.bzl", "copy_to_dist_dir")
load(
    "//build/kernel/kleaf:kernel.bzl",
    "kernel_abi",
    "kernel_build",
    "kernel_module",
    "kernel_module_group",
    "kernel_modules_install",
    "kernel_images",
    "kernel_unstripped_modules_archive",
    "merged_kernel_uapi_headers",
)
load("//build/kernel/kleaf:hermetic_tools.bzl", "hermetic_genrule")
load("//exynos/soc-series/common/impl:vendor_ramdisk.bzl", "create_vendor_ramdisk")
load("//exynos/soc-series/common/impl:dtbo_cfg.bzl", "dtbo_cfg")
load("//exynos/soc-series/common/impl:check_module_list.bzl", "check_module_list")
load(":modules.bzl",
    "get_common_kernel_modules_list",
    "get_all_vendor_boot_modules_list",
    "get_all_system_dlkm_blocklist",
    "get_all_vendor_dlkm_blocklist",
    "register_erd8825_module",
    "get_all_vendor_dlkm_modules_list",
    "get_all_kunit_test_list",
)
load("//exynos/soc-series/common/impl:create_blocklist.bzl", "create_blocklist")
load(":lego.bzl", "lego_module_list", "lego_dtbo_list", "lego_model")

package(
    default_visibility = [
        "//exynos/soc-series:__subpackages__",
    ],
)

mx_kernel_rules("erd8825", "papaya-android15")

__soc_dtbs = [
    "erd8825/" + f for f in lego_dtbo_list
]

__make_goals = [
    "modules",
    "dtbs",
]

write_file(
    name = "vendor_kunit_modules_list",
    out = "vendor_kunit_modules.erd8825",
    content = select({
        "//exynos/soc-series/common:eng_build": get_all_kunit_test_list("eng"),
        "//exynos/soc-series/common:userdebug_build": get_all_kunit_test_list("userdebug"),
        "//exynos/soc-series/common:user_build": get_all_kunit_test_list("user"),
    })
)

write_file(
    name = "vendor_dlkm_modules_list",
    out = "vendor_dlkm_modules.erd8825",
    content = select({
        "//exynos/soc-series/common:eng_build": get_all_vendor_dlkm_modules_list("eng"),
        "//exynos/soc-series/common:userdebug_build": get_all_vendor_dlkm_modules_list("userdebug"),
        "//exynos/soc-series/common:user_build": get_all_vendor_dlkm_modules_list("user"),
    })
)

write_file(
    name = "erd8825_vendor_dlkm_blocklist",
    out = "vendor_dlkm.modules.blocklist.erd8825",
    content = get_all_vendor_dlkm_blocklist()
)

write_file(
    name = "erd8825_system_dlkm_blocklist",
    out = "system_dlkm.modules.blocklist.erd8825",
    content = get_all_system_dlkm_blocklist()
)

create_blocklist(
    name = "erd8825_vendor_dlkm_modules_blocklist",
    modules_blocklist = ":erd8825_vendor_dlkm_blocklist"
)

create_blocklist(
    name = "erd8825_system_dlkm_modules_blocklist",
    modules_blocklist = ":erd8825_system_dlkm_blocklist"
)

kernel_build(
    name = "erd8825",
    base_kernel = "//common:kernel_aarch64",
    srcs = glob([
            "build.config.*",
            "arch/arm64/boot/dts/**",
            "arch/arm64/configs/**",
            "Kconfig.ext",
            "Kconfig.ext_modules",
        ],
        exclude =[
            ".*",
            ".*/**",
            "BUILD.bazel",
            "**/*.bzl",
            "build.config.*",
        ],
    ) + [
        # keep sorted
        "//common:common_kernel_sources",
        "//exynos/soc-series/papaya-android15:exynos.soc_kconfig",
        "//exynos/soc-series/papaya-android15:exynos.soc_fragment",
        "//exynos/soc-series/papaya-android15:build.config.s5e8825_v",
        "//exynos/soc-series/papaya-android15:exynos.dt-bindings",
        "//exynos/device/erd/erd8825:exynos.erd8825_kconfig",
        "//exynos/external-modules/camera:camera.kconfig",
        "//exynos/external-modules/bsp/class:sec_class_fvc.kconfig",
        "//exynos/external-modules/bsp/reboot/6.6:sec_reboot_fvc.kconfig",
        "//exynos/external-modules/bsp/factory/src:bsp_factory.kconfig",
        "//exynos/external-modules/bsp/debug/6.6_fvc:sec_debug.kconfig",
    ],
    kmi_symbol_list = select({
        "//exynos/soc-series/common:abi_update": "//common:android/abi_gki_aarch64_exynos",
        "//conditions:default": None,
    }),
    trim_nonlisted_kmi = False,
    kmi_symbol_list_strict_mode = False,
    outs = [
        ".config",
        "vmlinux",
        "Module.symvers",
        "modules.order",
        "exynos-base-dts/s5e8825.dtb",
    ] + [
        f + suffix for f in lego_dtbo_list for suffix in ["", ".reverse.dts"]
    ],
    kconfig_ext = ":Kconfig.ext",
    build_config = ":build.config.erd8825_v",
    dtstree = "//exynos/device/erd/erd8825/arch/arm64/boot/dts:erd8825_dt",
    # in-tree kernel modules
    module_outs = get_common_kernel_modules_list(),
    collect_unstripped_modules = True,
    strip_modules = True,
    make_goals = __make_goals,
    defconfig_fragments = select({
        "//exynos/soc-series/common:eng_build": [ ":arch/arm64/configs/eng.fragment"],
        "//exynos/soc-series/common:userdebug_build": [ ":arch/arm64/configs/userdebug.fragment"],
        "//exynos/soc-series/common:user_build": [ ":arch/arm64/configs/user.fragment"],
    })
)

kernel_abi(
    name = "erd8825_abi",
    kernel_build = ":erd8825",
    kernel_modules = [
        ":erd8825_ext_modules",
    ],
    kmi_enforced = True,
    kmi_symbol_list_add_only = True,
    module_grouping = True,
)

filegroup(
    name = "exynos.erd8825_sources",
    srcs = glob(
        ["**"],
        exclude = [
            ".*",
            ".*/**",
            "BUILD.bazel",
            "**/*.bzl",
            "build.config.*",
        ],
    ),
    visibility = [
        "//exynos/device:__subpackages__",
        "//exynos/soc-series:__subpackages__",
    ],
)

filegroup(
    name = "exynos.erd8825_kconfig",
    srcs = glob([
        "**/Kconfig",
    ]) + [
        "Kconfig.ext",
        "Kconfig.ext_modules",
    ],
    visibility = [
        "//exynos/device:__subpackages__",
    ],
)

alias(
    name = "erd8825_module",
    actual = select({
        "//exynos/soc-series/common:eng_build": ":erd8825_module.eng",
        "//exynos/soc-series/common:userdebug_build": ":erd8825_module.userdebug",
        "//exynos/soc-series/common:user_build": ":erd8825_module.user",
        "//exynos/soc-series/common:user_fac_build": ":erd8825_module.user.fac",
    }),
)

alias(
    name = "camera_modules",
    actual = select({
        "//exynos/soc-series/common:user_build":
        "//exynos/external-modules/camera:s5e8825_camera_user",
        "//conditions:default":"//exynos/external-modules/camera:s5e8825_camera",
    }),
)

kernel_module_group(
    name = "erd8825_ext_modules",
    srcs = [
        "//exynos/soc-series/common:exynos_soc_module",
        ":erd8825_module",
        ":camera_modules",
        "//exynos/external-modules/bsp/class:sec_class_fvc",
        "//exynos/external-modules/bsp/reboot/6.6:sec_reboot_fvc",
        "//exynos/external-modules/bsp/sec_bootstat/6.6:sec_bootstat_fvc",
        "//exynos/external-modules/bsp/sec_key_notifier/6.6:sec_key_notifier_fvc",
        "//exynos/external-modules/bsp/sec_crash_key_user/6.6:sec_crash_key_user_fvc",
        "//exynos/external-modules/bsp/sec_hard_reset_hook/6.6:sec_hard_reset_hook_fvc",
        "//exynos/external-modules/bsp/debug/6.6_fvc:sec_debug_modules",
    ],
)

kernel_modules_install(
    name = "erd8825_modules_install",
    kernel_build = "//exynos/soc-series/common:exynos_kernel_build",
    kernel_modules = [":erd8825_ext_modules"],
    outs = ["modules.dep", "modules.alias"],
)

check_module_list(
    name = "erd8825_check_module_list",
    kernel_modules_install = ":erd8825_modules_install",
    vendor_boot_kernel_modules = ":vendor_boot_modules_list",
    system_dlkm_kernel_modules = ":system_dlkm_modules_list",
    vendor_dlkm_kernel_modules = ":vendor_dlkm_modules_list",
)

merged_kernel_uapi_headers(
    name = "erd8825_merged_uapi_headers",
    kernel_build = "//exynos/soc-series/common:exynos_kernel_build",
    kernel_modules = [":erd8825_ext_modules"],
)

kernel_unstripped_modules_archive(
    name = "erd8825_module_symbols",
    kernel_build = "//exynos/soc-series/common:exynos_kernel_build",
    kernel_modules = [":erd8825_ext_modules"],
)

write_file(
    name = "vendor_boot_modules_list",
    out = "vendor_boot.modules.erd8825",
    content = select({
        "//exynos/soc-series/common:eng_build": get_all_vendor_boot_modules_list("eng"),
        "//exynos/soc-series/common:userdebug_build": get_all_vendor_boot_modules_list("userdebug"),
        "//exynos/soc-series/common:user_build": get_all_vendor_boot_modules_list("user"),
        "//exynos/soc-series/common:user_fac_build": get_all_vendor_boot_modules_list("user.fac"),
    })
)

write_file(
    name = "system_dlkm_modules_list",
    out = "system_dlkm_modules_list.erd8825",
    content = get_gki_modules_list("arm64"),
)

create_vendor_ramdisk(
    name = "erd8825_custom_vendor_ramdisk",
    vendor_files = [
        "//prebuilts/platform/erd8825:conf/fstab.s5e8825.ufs",
        "//prebuilts/platform/erd8825:conf/init.recovery.s5e8825.rc",
        "//prebuilts/platform/erd8825:conf/init.s5e8825.usb.rc",
    ],
    system_prebuilt_files = [
        "//prebuilts/boot-artifacts/arm64/exynos:system_prebuilt_files.tar.gz",
    ],
    vendor_ramdisk_list = [":vendor_ramdisk.cfg",],
)

kernel_images(
    name = "erd8825_images",
    build_initramfs = True,
    build_boot = True,
    build_vendor_boot = True,
    build_dtbo = True,
    dtbo_srcs = __soc_dtbs,
    kernel_build = "//exynos/soc-series/common:exynos_kernel_build",
    kernel_modules_install = "erd8825_modules_install",
    base_kernel_images = "//common:kernel_aarch64_images",
    vendor_ramdisk_binaries = [
          ":erd8825_custom_vendor_ramdisk",
    ],
    modules_list = ":vendor_boot_modules_list",
    modules_options = ":vendor_boot.modules.options",
    build_system_dlkm = True,
    system_dlkm_modules_list = ":system_dlkm_modules_list",
    system_dlkm_fs_type = "erofs",
    system_dlkm_modules_blocklist = ":erd8825_system_dlkm_modules_blocklist",
    dedup_dlkm_modules = True,
    build_vendor_dlkm = True,
    vendor_dlkm_archive = True,
    vendor_dlkm_fs_type = "erofs",
    vendor_dlkm_modules_list = ":vendor_dlkm_modules_list",
    vendor_dlkm_modules_blocklist = ":erd8825_vendor_dlkm_modules_blocklist",
    vendor_dlkm_props = ":vendor_dlkm_props",
    deps = [
        "//exynos/soc-series/common/impl:file_contexts",
    ],
)

dtbo_cfg(
    name = "erd8825_dtbo_cfg",
    srcs = __soc_dtbs,
    config_file = ":dtboimg.cfg",
)

copy_to_dist_dir(
    name = "erd8825_dist",
    data = [
        ":out_erd8825_debug",
        ":erd8825",
        ":erd8825_images",
        ":erd8825_modules_install",
        ":erd8825_module_symbols",
        ":erd8825_merged_uapi_headers",
        ":erd8825_check_module_list",
        ":vendor_kunit_modules_list",
        ":vendor_boot.modules.options",
    ],
    dist_dir = "out/erd8825/dist",
    flat = True,
    log = "info",
)


register_erd8825_module()
