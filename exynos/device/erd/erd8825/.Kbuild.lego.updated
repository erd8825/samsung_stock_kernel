obj-y += drivers/camera/

obj-y += drivers/tee/tzdev/
obj-y += drivers/tee/tui/
obj-y += drivers/usb/gadget/function/
obj-y += drivers/usb/dwc3/
obj-y += drivers/knox/
obj-y += drivers/samsung/pm/
obj-y += drivers/ufs/host/
obj-y += drivers/mmc/host/
obj-y += drivers/leds/
obj-y += block/
