config LEDS_S2MF301_FLASH
	tristate "FLASH LED support for the S2MF301"
    depends on I2C
	help
	  If you say yes here you will get support for
	  for the LEDS_S2MF301_FLASH led chip.

config LEDS_SM5714
	tristate "LED support for the SM5714"
	depends on MFD_SM5714
	help
	  This option enables support for the LEDs on the SM5714.
