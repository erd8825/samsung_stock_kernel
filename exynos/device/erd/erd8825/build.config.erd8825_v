BOARD_NAME=erd8825
BOARD_DIR=${ROOT_DIR}/exynos/device/erd/${BOARD_NAME}
ADDITIONAL_FRAGMENTS="${BOARD_DIR}/arch/arm64/configs/${BOARD_NAME}.fragment ${BOARD_DIR}/arch/arm64/configs/model_defconfig ${BOARD_DIR}/arch/arm64/configs/buildscript.fragment"

MAIN_KERNEL_VERSION=6.6

. ${ROOT_DIR}/exynos/soc-series/papaya-android15/build.config.s5e8825_v

DTC_FLAGS="${DTC_FLAGS} -a 4"
DTC_INCLUDE="${DTC_INCLUDE} ${BOARD_DIR}/include"
MKDTIMG_FLAGS="--custom0=/:dtbo-hw_rev --custom1=/:dtbo-hw_rev_end"

EXYNOS_EXT_MODULES_DIR=${ROOT_DIR}/${EXYNOS_BASE_DIR}/external-modules
KCONFIG_EXT_MODULES_PREFIX=$(realpath ${EXYNOS_EXT_MODULES_DIR} --relative-to ${KERNEL_DIR})/

: ${PAGE_16K_SUPPORT:=0}
BUILD_KASAN_DEFAULT_ON=""
#SKIP_ABI_UPDATE=1

VENDOR_BOOTCONFIG="
androidboot.dtbo_idx=0
androidboot.hardware=s5e8825
androidboot.boot_devices=13500000.ufs
androidboot.debug_level=0x4948
androidboot.selinux=permissive
"

