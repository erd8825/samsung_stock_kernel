# Helper to resolve issues with configs that have SPI enabled but I2C
# modular, meaning we can't build the codec driver in with I2C support.
# We use an ordered list of conditional defaults to pick the appropriate
# setting - SPI can't be modular so that case doesn't need to be covered.
config SND_SOC_I2C_AND_SPI
	tristate
	default m if I2C=m
	default y if I2C=y
	default y if SPI_MASTER=y

menu "CODEC drivers"

config SND_SOC_ALL_CODECS
	tristate "Build all ASoC CODEC drivers"
	depends on COMPILE_TEST
	imply SND_SOC_CS42L56
	imply SND_SOC_CS42L73
	imply SND_SOC_CS4234
	imply SND_SOC_CS4265
	imply SND_SOC_CS4270
	imply SND_SOC_CS4271_I2C
	imply SND_SOC_CS4271_SPI
	imply SND_SOC_CS42XX8_I2C
	help
	  Normally ASoC codec drivers are only built if a machine driver which
	  uses them is also built since they are only usable with a machine
	  driver.  Selecting this option will allow these drivers to be built
	  without an explicit machine driver for test and development purposes.


	  Support for the bus types used to access the codecs to be built must
	  be selected separately.

	  If unsure select "N".

config SND_SOC_ABOX_WM_ADSP
	tristate
	select FW_CS_DSP
	select SND_SOC_COMPRESS
	default m if SND_SOC_CS35L41_E=m
	default m if SND_SOC_CS35L43_E=m

config SND_SOC_CS35L41_E
	tristate "Cirrus Logic CS35L43 CODEC"

config SND_SOC_CS35L41_I2C_E
	tristate "Cirrus Logic CS35L43 CODEC (I2C)"
	depends on I2C
	select REGMAP_I2C
	select SND_SOC_CS35L41_E

config SND_SOC_CS35L41_SPI_E
	tristate "Cirrus Logic CS35L43 CODEC (SPI)"
	depends on SPI_MASTER
	select REGMAP_SPI
	select SND_SOC_CS35L41_E
endmenu
